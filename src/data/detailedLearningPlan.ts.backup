export const getCategoryColor = (category: string): string => {
  const colors: { [key: string]: string } = {
    'Python 基礎': '#0A84FF',
    'API Testing': '#30D158',
    'Testing': '#FF9F0A',
    'Payment': '#30D158',
    'Java': '#FF453A',
    'Database': '#5E5CE6',
    'DevOps': '#30D158',
    'Interview': '#FF9F0A',
    'Project': '#0A84FF'
  };
  return colors[category] || '#8E8E93';
};
