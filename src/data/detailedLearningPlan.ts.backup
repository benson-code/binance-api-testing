    {"currency": curr, "amount": amt}
    for curr in currencies
    for amt in amounts
]

print("\\n測試用例:")
for case in test_cases:
    print(case)
# 輸出:
# {'currency': 'USDT', 'amount': 100}
# {'currency': 'USDT', 'amount': 200}
# {'currency': 'BTC', 'amount': 100}
# {'currency': 'BTC', 'amount': 200}`,
