valid_amounts = [amt for amt in all_amounts if 0 < amt <= 10000]
print(f"有效金額: {valid_amounts}")  # [50, 100, 500, 200]

# 數據轉換：提取 API 響應中的特定字段
api_responses = [
    {"user_id": "123", "balance": 1000},
    {"user_id": "456", "balance": 2000},
    {"user_id": "789", "balance": 1500},
]

# 提取所有 user_id
